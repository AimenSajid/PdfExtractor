# Copy to .env and fill in. Never commit .env itself.

# Google AI Studio API key used for metadata extraction.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# SQLAlchemy connection string, e.g.
# postgresql+psycopg2://user:password@localhost:5432/pdf_extractor_db
DATABASE_URL=

# Google OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# (application type: Web application, authorized JS origin: http://localhost:5173).
# This value is public -- it also ships in the frontend bundle.
GOOGLE_CLIENT_ID=

# Secret used to sign our own session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every existing session.
JWT_SECRET=

# Set to true when serving over HTTPS so the session cookie carries the Secure flag.
COOKIE_SECURE=false

# Largest PDF accepted for upload, in megabytes. Uploads are held in memory and
# base64-encoded into the database, so raising this raises memory use too.
MAX_UPLOAD_MB=20
