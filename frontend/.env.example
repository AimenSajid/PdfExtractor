# Copy to .env and fill in. Never commit .env itself.
# Vite only exposes variables prefixed with VITE_ to the browser bundle,
# so never put a real secret in this file -- everything here is public.

# Same Google OAuth 2.0 Client ID as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Largest PDF the upload form accepts, in megabytes. Keep this at or below the
# backend's MAX_UPLOAD_MB and below the host's request body limit — Vercel
# rejects anything over 4.5MB before it reaches the function, with a platform
# error rather than ours.
VITE_MAX_UPLOAD_MB=4
